# Copy this file to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...

# Optional overrides:
# HOST=0.0.0.0     # bind to LAN so an iPad on the same Wi-Fi can connect
# PORT=8765

# Optional: enable in-app Epidemic Sound search.
# Without this, the app still suggests mood/genre/BPM and gives you a search URL
# to paste into epidemicsound.com.
# EPIDEMIC_SOUND_TOKEN=
# EPIDEMIC_SOUND_BASE_URL=https://api.epidemicsound.com/v0

# Public deploys only: protect with HTTP Basic auth.
# When set, every request needs Authorization: Basic <base64(user:pw)>
# except /api/health (so platform healthchecks still work).
# HFVP_AUTH_PASSWORD=alguma-senha-forte
# HFVP_AUTH_USER=admin

# Persistent storage dir. On Railway/Fly mount a volume and set this:
# HFVP_PROJECTS_DIR=/data/projects

# Real diarization (pyannote.audio). Requires HuggingFace token + the model
# accepted via https://huggingface.co/pyannote/speaker-diarization-3.1
# HF_TOKEN=
