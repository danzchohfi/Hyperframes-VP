# Copy this file to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...

# Optional overrides:
# HOST=0.0.0.0     # bind to LAN so an iPad on the same Wi-Fi can connect
# PORT=8765

# Optional: enable in-app Epidemic Sound search.
# Without this, the app still suggests mood/genre/BPM and gives you a search URL
# to paste into epidemicsound.com.
# EPIDEMIC_SOUND_TOKEN=
# EPIDEMIC_SOUND_BASE_URL=https://api.epidemicsound.com/v0
